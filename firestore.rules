rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 管理者：ドキュメントはコンソールで作成。本人はパスワード変更フラグだけ更新できる
    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mustChangePassword', 'passwordChangedAt'])
        && request.resource.data.mustChangePassword == false;
      allow create, delete: if false;
    }

    // シナリオと動画：誰でも読める、管理者だけ書ける
    match /scenarios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /scenarioMeta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 対戦セッション
    match /sessions/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow update: if signedIn()
        && (resource.data.hostUid == request.auth.uid || isAdmin())
        && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if isAdmin();

      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/sessions/$(code)).data.status == 'lobby';
        allow update: if signedIn() && request.auth.uid == uid;
        allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }
    }

    // プレイログ・監査ログ：本人が追記のみ、閲覧は管理者のみ、改ざん不可
    match /logs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
